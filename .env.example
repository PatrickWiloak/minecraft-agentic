# Minecraft Server
MC_HOST=localhost
MC_PORT=25565
# Minecraft version for the server AND the bots. Leave at 1.20.1 - it's the version
# the browser viewer supports exactly (other versions can render wrong blocks).
# MC_VERSION=1.20.1
# Single-agent bot name. If you change this, run `npm run ops -- <name>` and restart the
# server (or `op <name>` in the server console) so the bot has permission to build.
MC_USERNAME=BuilderBot

# ---------------------------------------------------------------------------
# AI backend - which model designs the builds.
# You need NONE of these to start: with no key, the crew builds from the free
# built-in library. Add ONE key to build your own prompts.
#
# LLM_PROVIDER is auto-detected from whichever key you set below. Set it
# explicitly (claude | gemini | openai | ollama | library) only to override.
# ---------------------------------------------------------------------------
LLM_PROVIDER=

# Google Gemini - has a FREE tier, recommended for most people.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude - highest quality (paid). https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (paid). https://platform.openai.com/
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Ollama - fully local, no key, but needs a real GPU and quality varies.
# Install from https://ollama.com, run `ollama serve`, then set LLM_PROVIDER=ollama.
# OLLAMA_MODEL=llama3.1
# OLLAMA_HOST=http://localhost:11434

# Force a specific library build for the no-key demo
# (castle | wizardTower | cottage | lighthouse | windmill | pagoda | ship | temple | observatory)
# LIBRARY_BUILD=

# Browser viewer (watch the build at http://localhost:PORT - no Minecraft client needed)
# Change the port if 3000 is taken. Set VIEWER=off (or pass --no-viewer) to disable it.
VIEWER_PORT=3000
VIEWER=

# Web control panel (`npm run web`) - the interactive prompt+watch page. Port only.
WEB_PORT=8080
